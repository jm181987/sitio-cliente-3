# PostgreSQL
# Configure the real value only in your local environment or deployment platform.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false

# S3-compatible object storage (MinIO, Cloudflare R2, AWS S3, etc.)
STORAGE_ENDPOINT=https://storage.example.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=your-access-key
STORAGE_SECRET_ACCESS_KEY=your-secret-key
STORAGE_PUBLIC_BUCKET=public-assets
STORAGE_PRIVATE_BUCKET=private-assets
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com/public-assets
STORAGE_FORCE_PATH_STYLE=true

# Site origin used for CORS
NEXT_PUBLIC_SITE_URL=http://localhost:3000
